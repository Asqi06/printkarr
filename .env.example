# ---- Printkarr environment ----
# Local use: copy to `.env` (server loads it via dotenv).
# Hosts (Render / Railway / VPS): paste these into the host's env dashboard.

PORT=3000
NODE_ENV=production

# Owner admin — created automatically on FIRST boot when the DB is empty.
# The demo accounts are never created in production.
ADMIN_EMAIL=you@yourdomain.in
ADMIN_PASSWORD=<long-random-password>

# Demo logins (customer/rider/admin @demo.printkarr.in + demo cards).
# on = local testing (default) · off = production kills them entirely.
DEMO_LOGIN=off

# ---- Live map (Leaflet + OpenStreetMap — NO keys needed) ----
# Hub pin (defaults: Sarigam, Gujarat). Find yours at openstreetmap.org.
HUB_LAT=20.2825
HUB_LNG=72.8349
# Tiles default to free CARTO Voyager (OSM data, no key, no blocking).
# Override only for another style or provider:
# MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=© OpenStreetMap contributors
# Mapbox later:
# MAP_TILES_URL=https://api.mapbox.com/styles/v1/mapbox/streets-v12/tiles/{z}/{x}/{y}?access_token=YOUR_MAPBOX_TOKEN

# ---- Later (PRD Phase 2/3) — recognised but not used yet ----
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
WHATSAPP_TOKEN=
DATABASE_URL=

# 1. console.cloud.google.com → new project → OAuth consent screen (External).
# 2. Credentials → Create → OAuth client ID → Web application.
# 3. Authorized redirect URIs — add BOTH lines exactly:
#      http://localhost:3000/auth/google/callback
#      https://YOUR-LIVE-DOMAIN/auth/google/callback
# 4. Paste the client ID + secret below. The login page then shows
#    "Continue with Google". No keys = button hides, demo login only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- WhatsApp order forwarding (NO api key needed) ----
# Your number in international format, digits only. Every order page then
# shows a button opening a chat with the full order brief + PDF link.
OWNER_WHATSAPP_NUMBER=91XXXXXXXXXX

# ---- V0 classroom pilot (laptop print server, Windows) ----
# Agent token: any long random string, shared between server and agent.
AGENT_TOKEN=
# Exact Windows printer name (Printer settings → Epson entry).
PRINTER_NAME=Epson L3250 Series
# Full path to SumatraPDF portable (free). Omit only for DRY_RUN testing.
SUMATRA_PDF=C:\Users\WELCOME\AppData\Local\SumatraPDF\SumatraPDF.exe
# Optional overrides: PRINT_SETTINGS="duplexlong,monochrome" verbatim flags,
# QPDF_BIN=C:\tools\qpdf.exe (page-range subsetting), POLL_MS=15000,
# FILE_RETENTION_MINUTES=15 (print files auto-delete 15 min after terminal state).
