{
  "name": "printkarr",
  "version": "0.1.0",
  "description": "Printkarr â€” hyperlocal print + stationery ordering and delivery (demo build, PRD Phase 1).",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "agent": "node agent/print-agent.mjs",
    "test:print": "node scripts/test-print.mjs",
    "test:print-safety": "node scripts/print-safety-check.mjs",
    "seed": "node data/seed.js",
    "reset-prod": "node data/reset.js",
    "init:atlas": "node scripts/init-atlas.mjs",
    "test:atlas": "node scripts/test-atlas.mjs",
    "test:atlas-safety": "node scripts/atlas-safety-check.mjs",
    "test": "node --test lib/pricing-cod.test.js agent/cover.test.js agent/print-settings.test.js lib/machine.test.js lib/packs.test.js lib/referrals.test.js lib/campus.test.js lib/kiosk.test.js lib/collect.test.js lib/files.test.js lib/db.test.js lib/owner-test.test.js agent/instance-lock.test.js lib/reviews.test.js lib/notify.test.js lib/influencers.test.js",
    "test:design": "node scripts/design-check.mjs",
    "test:delivery": "node scripts/delivery-service-check.mjs",
    "test:checkout": "node scripts/checkout-check.mjs && node scripts/direct-checkout-check.mjs",
    "test:store": "node scripts/store-check.mjs",
    "test:ux": "node scripts/mixed-print-check.mjs && node scripts/split-print-check.mjs && node scripts/address-ux-check.mjs",
    "preview:orders": "node scripts/order-preview.mjs",
    "preview:store": "node scripts/store-preview.mjs",
    "test:seo": "node scripts/seo-check.mjs",
    "agent:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-agent.ps1",
    "agent:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-agent.ps1 -Mode Status",
    "agent:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-agent.ps1 -Mode Uninstall",
    "test:studio": "node scripts/studio-check.mjs",
    "test:checklist": "node scripts/checklist-check.mjs",
    "test:pages": "node scripts/site-coverage-check.mjs",
    "preview:pages": "node scripts/site-coverage-check.mjs --serve"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "mongodb": "^7.6.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pdf-lib": "1.17.1",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
